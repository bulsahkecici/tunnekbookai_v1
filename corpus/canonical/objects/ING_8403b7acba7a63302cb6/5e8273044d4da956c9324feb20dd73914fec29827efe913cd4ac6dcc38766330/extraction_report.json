    {
      "slide_number": 5,
      "title": "Zemin İyileştirme Yöntemleri",
      "text": "Enjeksiyon (Permeasyon, Kompaksiyon, Jet Grout)\n\nDeep Mixing (Derin Karıştırma)\n\nKazıklar\n\nAnkrajlar",
      "tables": [],
