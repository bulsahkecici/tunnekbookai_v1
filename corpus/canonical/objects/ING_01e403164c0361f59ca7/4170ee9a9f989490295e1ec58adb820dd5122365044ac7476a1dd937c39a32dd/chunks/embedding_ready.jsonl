{"chunk_id": "ING_01e403164c0361f59ca7_CH_694c9504ae", "document_id": "ING_01e403164c0361f59ca7", "chunk_type": "SLIDE_CHUNK", "section_id": "2.4.1.2", "secondary_section_ids": ["5.4", "2.4.1", "5.1"], "ordinal": 1, "text_path": null, "embedding_text": "KARAYOLLARI GENEL MÜDÜRLÜĞÜ\nSlayt 1: KARAYOLLARI GENEL MÜDÜRLÜĞÜ\nKARAYOLLARI GENEL MÜDÜRLÜĞÜ\n\nKM: 13+617 – 15+054 \nT1 TÜNELİ\n\nGÖÇÜKLERİNİN DEĞERLENDİRİLMESİ", "token_count": 25, "page_start": 1, "page_end": 1, "slide_number": 1, "sheet_name": null, "provenance": {"original_sha256": "01e403164c0361f59ca716cbdc834029883212f24feab0c290022d9d089ea82d", "source_kind": "MANUAL_INTERNAL", "format": "PPTX", "evidence_level": "FULL_TEXT"}, "chunk_schema_version": "1.0", "chunk_policy_version": "structure-aware-v1", "eligible": true, "reason": "READY"}
