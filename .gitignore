.DS_Store
.AppleDouble
.LSOverride
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.idea/
.vscode/
node_modules/
build/
dist/
.env
.env.*
!.env.example
*.log
*.tmp
*.swp

# Downloaded source material, model/vector stores, and reproducible runtime output
data/downloads/*
!data/downloads/.gitkeep
data/qdrant_storage/
data/qdrant_snapshots/
data/embeddings/
data/embeddings_pilot/
book/retrieval/builds/
book/retrieval/indexes/
data/temp/
data/temporary/*
!data/temporary/.gitkeep

# Large derived corpus/handoff artifacts; canonical text and metadata remain versioned
corpus/sidecars/
corpus/staging/
corpus/rejects/
corpus/promoted_v2/
handoff/accepted/

# Unified Ingest Engine runtime artifacts (user data + derived bundles)
incoming/manual/inbox/*
!incoming/manual/inbox/.gitkeep
incoming/manual/*.pdf
incoming/manual/*.docx
incoming/manual/*.pptx
incoming/manual/*.xlsx
incoming/manual/*.png
incoming/manual/*.jpg
incoming/manual/*.jpeg
incoming/papercrawler/releases/*
!incoming/papercrawler/releases/.gitkeep
incoming/quarantine/*
!incoming/quarantine/.gitkeep
originals/*
!originals/.gitkeep
processing/*
!processing/.gitkeep
audit/ingest_state.jsonl
audit/ingest_manifest.jsonl
audit/source_registry.jsonl
audit/document_id_map.jsonl
audit/ingest_dry_run.json
audit/unified_ingest_quality.json
audit/embedding_ready_manifest.jsonl
audit/canonical_promotions/canonical.lock
audit/corpus_population/population.lock
# Local rollback archives can exceed 1 GB; keep them on disk, not in Git.
audit/corpus_population/recovery/**/*.tar
audit/dashboard/
test-results/
playwright-report/
