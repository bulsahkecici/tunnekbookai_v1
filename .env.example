# Optional override. Defaults to <project>/data/downloads.
TUNNEL_PAPERS_DIR=

# Public scholarly discovery identification only; never put private corpus text here.
OPENALEX_MAILTO=tunnel-crawler@localhost

# Local-only OpenAI-compatible services. Remote LLM endpoints are rejected.
TUNNEL_EMBEDDING_SERVER=http://127.0.0.1:1234/v1
TUNNEL_LLM_SERVER=http://127.0.0.1:1234/v1
