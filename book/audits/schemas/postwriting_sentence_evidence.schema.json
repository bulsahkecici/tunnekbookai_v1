{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TunnelBookAI post-writing sentence evidence result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sentence_id", "paragraph_id", "section_id", "sentence", "status",
    "mapped_claim_ids", "supporting_claim_ids", "supporting_document_ids",
    "source_locators", "question_ids", "reason_code", "confidence"
  ],
  "properties": {
    "sentence_id": {"type": "string", "minLength": 1},
    "paragraph_id": {"type": "string", "minLength": 1},
    "section_id": {"type": "string", "minLength": 1},
    "sentence": {"type": "string", "minLength": 10},
    "status": {"enum": ["SUPPORTED", "PARTIAL", "UNSUPPORTED", "NON_FACTUAL_OR_EDITORIAL"]},
    "mapped_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "supporting_claim_ids": {"type": "array", "items": {"type": "string"}},
    "supporting_document_ids": {"type": "array", "items": {"type": "string"}},
    "source_locators": {"type": "array", "items": {"type": "string"}},
    "question_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reason_code": {
      "enum": ["DIRECT_SUPPORT", "COMPOSITE_SUPPORT", "CLAIM_OVERREACH", "NO_DIRECT_SUPPORT", "EDITORIAL_SENTENCE"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
