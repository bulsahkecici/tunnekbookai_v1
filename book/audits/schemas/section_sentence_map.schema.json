{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TunnelBookAI section sentence-to-claim map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "draft_id", "section_id", "paragraphs", "sentences"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "section-writer-v1"},
    "draft_id": {"type": "string", "pattern": "^DRF_[0-9a-f]{64}$"},
    "section_id": {"type": "string", "minLength": 1},
    "paragraphs": {"type": "array", "minItems": 1},
    "sentences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sentence_id", "paragraph_id", "text", "claim_ids", "question_ids",
          "document_ids", "source_locators", "audit_status"
        ],
        "properties": {
          "sentence_id": {"type": "string", "minLength": 1},
          "paragraph_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 10},
          "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "question_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "document_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_locators": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "audit_status": {"const": "PENDING_POSTWRITING_EVIDENCE_AUDIT"}
        }
      }
    }
  }
}
