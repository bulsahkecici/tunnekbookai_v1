{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TunnelBookAI constrained section evidence packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "section_id",
    "section_title",
    "readiness",
    "identity",
    "claim_registry_id",
    "claim_registry_file",
    "question_count",
    "evidence_counts",
    "questions",
    "writer_constraints",
    "packet_id"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "section-preparation-v1"},
    "section_id": {"type": "string", "minLength": 1},
    "section_title": {"type": "string", "minLength": 1},
    "readiness": {
      "enum": ["READY", "READY_WITH_LIMITATIONS", "EVIDENCE_GAP", "HUMAN_ANALYSIS_ARTIFACT_REQUIRED", "BLOCKED"]
    },
    "identity": {"type": "object"},
    "claim_registry_id": {"type": "string", "pattern": "^SCR_[0-9a-f]{64}$"},
    "claim_registry_file": {"const": "claim_registry.json"},
    "question_count": {"const": 50},
    "evidence_counts": {"type": "object"},
    "questions": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id", "question", "evidence_status", "reason_code", "confidence",
          "allowed_claim_ids", "drafting_permission"
        ],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "evidence_status": {"enum": ["SUPPORTED", "PARTIAL", "UNSUPPORTED"]},
          "reason_code": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "allowed_claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^CLM_[0-9a-f]{64}$"}
          },
          "drafting_permission": {
            "enum": ["DIRECT_WITH_CITATION", "LIMITED_WITH_QUALIFIER", "NO_FACTUAL_ANSWER"]
          }
        }
      }
    },
    "writer_constraints": {"type": "object"},
    "packet_id": {"type": "string", "pattern": "^SEP_[0-9a-f]{64}$"}
  }
}
