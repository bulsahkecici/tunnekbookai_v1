{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TunnelBookAI pre-writing evidence audit",
  "type": "object",
  "required": ["question_id", "section_id", "evidence_status", "supporting_documents"],
  "properties": {
    "question_id": {"type": "string"},
    "section_id": {"type": "string"},
    "evidence_status": {"enum": ["SUPPORTED", "PARTIALLY_SUPPORTED", "INSUFFICIENT_EVIDENCE", "NO_EVIDENCE", "NOT_EVALUATED"]},
    "supporting_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "canonical_id", "source_tier", "evidence_level", "relevance_score"],
        "properties": {
          "document_id": {"type": "string"},
          "canonical_id": {"type": "string"},
          "source_tier": {"enum": ["TIER_A", "TIER_B", "TIER_C", "TIER_D"]},
          "evidence_level": {"enum": ["FULL_TEXT", "PDF_EXTRACT", "ABSTRACT", "WEBPAGE_TEXT", "TITLE_METADATA_ONLY"]},
          "relevance_score": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
