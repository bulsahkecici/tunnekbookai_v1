{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TunnelBookAI pre-writing question evidence audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "section_id",
    "question",
    "status",
    "retrieved_chunk_ids",
    "document_ids",
    "source_locators",
    "reason_code",
    "confidence"
  ],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "section_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "status": {"enum": ["SUPPORTED", "PARTIAL", "UNSUPPORTED"]},
    "retrieved_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "document_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "source_locators": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "authority_and_provenance": {"type": "array", "items": {"type": "object"}},
    "reason_code": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
