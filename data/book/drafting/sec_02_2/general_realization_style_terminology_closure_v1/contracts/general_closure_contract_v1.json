{
  "version": "tunnelbook-general-realization-style-terminology-closure-v1",
  "additive_to": [
    "tunnelbook-claim-realization-contract-v2.2-retry-v1",
    "tunnelbook-book-style-contract-v1",
    "tunnelbook-deterministic-book-style-integration-v2.2"
  ],
  "scope": "claim-independent pre-render feasibility and post-render release gate",
  "pre_render": {
    "material_render_roles": ["BODY_SENTENCE"],
    "subject_types": ["ENTITY", "FACT", "FACT_SET", "PROCESS", "CONDITION_SET"],
    "predicate_types": ["COPULAR", "REQUIREMENT", "RELATION", "ACTION", "CONDITION"],
    "require_typed_subject_predicate": true,
    "require_complete_sentence_feasibility": true,
    "require_single_preferred_term_per_concept": true,
    "claim_specific_branches": "FORBIDDEN"
  },
  "post_render": {
    "require_all_semantic_anchors": true,
    "material_fragments": "REJECT",
    "material_note_labels": "REJECT",
    "free_terminology_variants": "REJECT",
    "post_render_rewrite": "FORBIDDEN"
  },
  "advisory_lints": {
    "strength_class_unit_duplication": {
      "severity": "ADVISORY",
      "pattern": "\\bC[0-9]+/[0-9]+\\s*MPa\\b",
      "message": "Strength-class notation already encodes the class; an attached MPa unit is redundant or ambiguous."
    }
  },
  "preservation": {
    "technical_blockers": 6,
    "condition_dependency_closure": true,
    "unresolved_term_fallback": true,
    "citation_allocation": true,
    "book_style_contract": true,
    "historical_artifacts_mutable": false
  }
}
