  "policy": {
    "auto_repair": false,
    "auto_repair_rationale": "A failed sentence must be visible as a failure. Asking the generator to fix it inside the same attempt launders an unsupported proposition into an apparently successful draft, and the audit trail then records a pass.",
    "fail_closed": true,
    "no_translation_repair": true,
    "no_translation_repair_rationale": "The validator rejects a mistranslated unit; it never translates one. Repairing input inside the validator would turn a translation failure into a pass and record it as one.",
    "pilot_policy": "all_or_nothing",
    "pilot_policy_rationale": "In v1 an optional rejected unit rejects the whole pilot rather than being dropped. Silently discarding failures would make the acceptance rate a function of how much prose was thrown away.",
