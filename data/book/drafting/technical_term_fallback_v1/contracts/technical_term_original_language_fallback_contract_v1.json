{
  "version": "tunnelbook-technical-term-original-language-fallback-contract-v1",
  "scope": "general_book_technical_terms",
  "states": {
    "AUTHORITATIVE_TRANSLATION": {
      "authoritative_translation": "required",
      "display_mode": "PLAIN",
      "language_exemption": false
    },
    "ORIGINAL_TERM_UNRESOLVED": {
      "authoritative_translation": null,
      "display_mode": "BOLD",
      "language_exemption": "exact_registered_span_only"
    }
  },
  "required_record_fields": [
    "term_id", "canonical_source_term", "canonical_source_term_sha256", "source_language",
    "status", "claim_ids", "source_keys", "display_mode", "authoritative_translation",
    "resolution_version", "semantic_effect"
  ],
  "unresolved_invariants": {
    "source_term_byte_identical": true,
    "spelling_normalisation": false,
    "stemming": false,
    "synonym_substitution": false,
    "explanatory_gloss": false,
    "semantic_markdown": false,
    "semantic_effect": "lexical_identity_only"
  },
  "presentation": {
    "BOLD": {"prefix": "**", "suffix": "**"},
    "markdown_applied_after_semantic_and_ownership_validation": true,
    "markdown_removed_before_ownership_comparison": true
  },
  "language_validation": {
    "parent": "tunnelbook-draft-language-validator-v1",
    "parent_modified": false,
    "exemption_binding": ["term_id", "canonical_source_term", "claim_ids", "source_keys"],
    "arbitrary_english_rejected": true,
    "unregistered_terms_rejected": true
  },
  "replacement": {
    "historical_records_immutable": true,
    "new_resolution_version_required": true,
    "central_registry_selects_latest_approved_resolution": true,
    "manual_prose_edit_required": false,
    "deterministic_rerender_required": true
  },
  "implementation_constraints": {
    "claim_specific_branches": [],
    "term_specific_branches": [],
    "global_gloss_widening": false,
    "global_lexicon_widening": false,
    "renderer_patch": false,
    "validator_weakening": false
  },
  "failure_codes": [
    "TERM_SCHEMA_INVALID", "TERM_STATUS_INVALID", "TERM_MARKDOWN_IN_SEMANTIC_VALUE",
    "TERM_SOURCE_TERM_MISMATCH", "TERM_UNRESOLVED_HAS_TRANSLATION",
    "TERM_AUTHORITATIVE_TRANSLATION_REQUIRED", "TERM_AUTHORITATIVE_TRANSLATION_MISMATCH",
    "TERM_DISPLAY_MODE_MISMATCH", "TERM_UNRESOLVED_MARKER_MISSING",
    "TERM_PRESENTATION_CONTAMINATES_OWNERSHIP", "TERM_UNREGISTERED_VISIBLE_TERM",
    "TERM_CROSS_CLAIM_BORROWING", "TERM_SOURCE_OWNERSHIP_MISMATCH",
    "TERM_CLAIM_SPECIFIC_BRANCH_FORBIDDEN", "TERM_SILENT_REPLACEMENT",
    "TERM_CLAIM_MEANING_CHANGED", "LANGUAGE_MISMATCH", "LANGUAGE_AMBIGUOUS"
  ]
}
